# Normalize line endings: treat these as text and store LF in the repo.
# This prevents CRLF churn (whole-file "changes" and spurious merge conflicts)
# when files are edited on/transferred through Windows tooling.

# Default: let git detect text vs binary and normalize text to LF.
* text=auto eol=lf

# Explicit text types (belt and braces)
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.conf   text eol=lf
*.service text eol=lf
*.m      text eol=lf
*.f90    text eol=lf
Makefile text eol=lf
*.yml    text eol=lf
*.clang-format text eol=lf

# Binary files: never touch their bytes.
*.iq     binary
*.c2     binary
*.wav    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.dat    binary
*.zip    binary
*.o      binary
